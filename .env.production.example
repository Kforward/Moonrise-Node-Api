NODE_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGIN=https://your-production-domain.example
LOG_LEVEL=info

DATABASE_DRIVER=postgresql
DATABASE_URL=postgresql://moonrise_prod_user:change-me-strong-password@127.0.0.1:5432/moonrise_prod

JWT_ACCESS_SECRET=change-me-long-random-production-access-secret
JWT_REFRESH_SECRET=change-me-long-random-production-refresh-secret

WECHAT_LOGIN_MODE=code2session
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
